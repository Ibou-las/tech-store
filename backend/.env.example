# Copier ce fichier vers .env et remplacer les valeurs secrètes.
DJANGO_SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
# Mot de passe local PostgreSQL pour Docker Compose (utiliser lettres/chiffres pour simplifier l'URL)
POSTGRES_PASSWORD=ChangeThisLocalPassword12345
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Stockage distant optionnel des photos (Supabase Storage S3-compatible).
# Laisser vide en local pour stocker dans backend/media/. En production, renseigner TOUTES ces valeurs.
SUPABASE_URL=
AWS_STORAGE_BUCKET_NAME=product-images
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
